# Copy to .env.esp32 (git-ignored) and fill in real values.
# Sourced by build.sh before every `pio` invocation; interpolated into
# platformio.ini via ${sysenv.*} so nothing is hardcoded in firmware source.

ESP32_WIFI_SSID=your-wifi-ssid
ESP32_WIFI_PASSWORD=your-wifi-password

ESP32_MQTT_HOST=192.0.2.10
ESP32_MQTT_PORT=1883
ESP32_MQTT_USERNAME=
ESP32_MQTT_PASSWORD=
ESP32_MQTT_TRIGGER_TOPIC=doorbell/trigger

# Same MinIO instance the Python pipeline's AWS_ENDPOINT_URL/AWS_ACCESS_KEY_ID/
# AWS_SECRET_ACCESS_KEY already point at (see repo root .env) — copy the values
# from there, do not invent new credentials.
ESP32_MINIO_ENDPOINT=192.0.2.20:9000
ESP32_MINIO_ACCESS_KEY=your-access-key
ESP32_MINIO_SECRET_KEY=your-secret-key
ESP32_MINIO_BUCKET=doorbell-detector
ESP32_MINIO_REGION=us-east-1

ESP32_DEVICE_ID=xiao-sense-01
# POSIX TZ string, e.g. "CET-1CEST,M3.5.0,M10.5.0/3" for Central Europe, or
# "UTC0" to keep everything in UTC (simplest if you don't care about local time).
ESP32_TZ=UTC0
